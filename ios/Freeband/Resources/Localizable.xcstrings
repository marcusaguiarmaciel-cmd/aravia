            "state": "translated",
            "value": "Yoğun günler, düşük toparlanma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias puxados, recuperação baixa"
          }
        }
      }
    },
    "%@, your normal is %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, normalin %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, o seu normal é %@."
          }
        }
      }
    },
    "%@, your normal is %@. %lld days in a row.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, normalin %2$@. %3$lld gündür böyle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, o seu normal é %@. %lld dias seguidos."
          }
        }
      }
    },
    "%lld ms, your normal is %lld ms.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ms, normalin %2$lld ms."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ms, o seu normal é %lld ms."
          }
        }
      }
    },
    "%lld ms, your normal is %lld ms. %lld nights in a row.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ms, normalin %2$lld ms. %3$lld gecedir böyle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ms, o seu normal é %lld ms. %lld noites seguidas."
          }
        }
      }
    },
    "%@ less than you need over the last %lld nights.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %2$lld gecede ihtiyacından %1$@ az uyudun."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a menos do que você precisa nas últimas %lld noites."
          }
        }
      }
    },
    "The middle of your night moved by %@.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecenin ortası %@ kaydı."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O meio da sua noite mudou %@."
          }
        }
      }
    },
    "Recovery is %lld after %lld days of strain above your normal.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalinin üstünde yükle geçen %2$lld günün ardından toparlanma %1$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação está em %lld depois de %lld dias de desgaste acima do seu normal."
          }
        }
      }
    },
    "Lets %@ find this phone and sync on its own. Mi Fitness can't connect while it's on.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu telefonu bulabilir ve kendiliğinden senkron olur. Açıkken Mi Fitness bağlanamaz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa %@ encontrar este celular e sincronizar sozinho. O Mi Fitness não consegue se conectar enquanto isso está ligado."
          }
        }
      }
    },
    "The day, hour by hour": {
      "localizations": {
