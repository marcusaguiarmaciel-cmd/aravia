          }
        }
      }
    },
    "Stops after 2 minutes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 dakika sonra durur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para depois de 2 minutos."
          }
        }
      }
    },
    "Strain": {
      "comment": "Score name",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desgaste"
          }
        }
      }
    },
    "Strain counts how hard your heart worked while you were awake, from 0 to 21.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük, uyanıkken kalbinin ne kadar çalıştığını 0 ile 21 arasında sayar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desgaste mede o quanto o seu coração trabalhou enquanto você estava acordado, de 0 a 21."
          }
        }
      }
    },
    "Strain is 21 × ln(1 + load ÷ 25) ÷ ln 25, at most 21: a load of 100 is about 10.5, 200 about 14.3.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük = 21 × ln(1 + efor ÷ 25) ÷ ln 25, en fazla 21: 100 efor yaklaşık 10,5, 200 efor yaklaşık 14,3 eder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desgaste é 21 × ln(1 + carga ÷ 25) ÷ ln 25, no máximo 21: uma carga de 100 dá cerca de 10,5, e 200, cerca de 14,3."
          }
        }
      }
    },
    "Stress": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stres"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estresse"
          }
        }
      }
    },
    "Switch band": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant değiştir"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar de relógio"
          }
        }
      }
    },
    "Sync": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronla"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar"
          }
        }
      }
    },
    "Sync band": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandı senkronize et"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar relógio"
          }
        }
      }
    },
    "Sync progress": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkron ilerlemesi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso da sincronização"
          }
        }
      }
    },
    "Synced": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronize edildi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizado"
          }
        }
      }
    },
    "Synced %@": {
      "comment": "Last sync, date",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ senkronlandı"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizado %@"
          }
        }
      }
    },
    "Synced %lld h ago": {
      "comment": "Last sync, hours",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sa önce senkronlandı"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizado há %lld h"
          }
        }
      }
    },
    "Synced %lld min ago": {
      "comment": "Last sync, minutes",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dk önce senkronlandı"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizado há %lld min"
          }
        }
      }
    },
    "Synced just now": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce senkronlandı"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizado agora"
          }
        }
      }
    },
    "Syncing %lld of %lld": {
      "comment": "Files synced so far",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkron %1$lld/%2$lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizando %lld de %lld"
          }
        }
      }
    },
    "Syncing.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronize ediliyor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizando."
          }
        }
      }
    },
    "Tap Choose folder.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasörü seç'e dokun."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Escolher pasta."
          }
        }
      }
    },
    "Tap Open.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aç'a dokun."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Abrir."
          }
        }
      }
    },
    "Tesla language: one focal object, two weights, blue only to commit.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesla dili: tek odak nesnesi, iki ağırlık, mavi yalnızca onay için."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linguagem de design: um objeto em foco, dois pesos, a cor de destaque só para confirmar."
          }
        }
      }
    },
    "The address must start with https:// and include a domain.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres https:// ile başlamalı ve bir alan adı içermeli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço precisa começar com https:// e ter um domínio."
          }
        }
      }
    },
    "The band answered.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant cevap verdi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio respondeu."
          }
        }
      }
    },
    "The band didn't answer. Close Mi Fitness and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant cevap vermedi. Mi Fitness'ı kapatıp tekrar dene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio não respondeu. Feche o Mi Fitness e tente de novo."
          }
        }
      }
    },
    "The band didn't open its data channel. Try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant veri kanalını açmadı. Tekrar dene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio não abriu o canal de dados. Tente de novo."
          }
        }
      }
    },
    "The band didn't record sleep stages for this night.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant bu gece için uyku evresi kaydetmedi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio não registrou fases do sono nesta noite."
          }
        }
      }
    },
    "The band only talks to an app that knows its key. Mi Fitness keeps it in its folder on this phone; Freeband reads it from there and stores it only in this phone's keychain.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant yalnızca anahtarını bilen uygulamayla konuşur. Mi Fitness bu anahtarı telefondaki klasöründe tutar; Freeband onu oradan okur ve yalnızca bu telefonun anahtar zincirinde saklar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio só conversa com um app que conhece a chave dele. O Mi Fitness guarda essa chave na pasta dele neste celular; o Aravia lê de lá e guarda só nas Chaves (keychain) deste celular."
          }
        }
      }
    },
    "The band recorded no beat-to-beat (RR) intervals, so heart rate variability is left out.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant atımdan atıma (RR) aralık kaydetmedi; bu yüzden nabız değişkenliği hesaba katılmadı."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio não registrou intervalos batimento a batimento (RR), então a variabilidade da frequência cardíaca ficou de fora."
          }
        }
      }
    },
    "The band refused the connection. Close Mi Fitness and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant bağlantıyı reddetti. Mi Fitness'ı kapatıp tekrar dene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio recusou a conexão. Feche o Mi Fitness e tente de novo."
          }
        }
      }
    },
    "The band vibrates until you stop it or tap it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bant, sen durdurana ya da ona dokunana kadar titrer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio vibra até você parar ou tocar nele."
          }
        }
      }
    },
    "The band's files": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandın dosyaları"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos do relógio"
          }
        }
      }
    },
    "The connection dropped. Bring the band closer and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı koptu. Bandı yaklaştırıp tekrar dene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão caiu. Aproxime o relógio e tente de novo."
          }
        }
      }
    },
    "The invite code isn't valid. Ask the server's owner for a code.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet kodu geçersiz. Sunucunun sahibinden bir kod iste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código de convite não é válido. Peça um código a quem administra o servidor."
          }
        }
      }
    },
    "The key doesn't match this band. Sync the band in Mi Fitness, then read the key again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar bu bantla eşleşmiyor. Bandı Mi Fitness'ta senkronize et, sonra anahtarı yeniden oku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave não corresponde a este relógio. Sincronize o relógio no Mi Fitness e leia a chave de novo."
          }
        }
      }
    },
    "The line fills in as readings arrive.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçümler geldikçe çizgi dolar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha vai se formando conforme as leituras chegam."
          }
        }
      }
    },
    "The night": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A noite"
          }
        }
      }
    },
    "The other bands connect on their first sync.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer bantlar ilk senkronlarında bağlanır."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros relógios se conectam na primeira sincronização."
          }
        }
      }
    },
    "The server answered %lld: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu %1$lld döndürdü: %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor respondeu %lld: %@"
          }
        }
      }
    },
    "The server didn't recognise the API key. If you renewed it on the web panel, paste the new key in Web access › Enter API key.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu API anahtarını tanımadı. Anahtarı web panelinde yenilediysen yenisini Web erişimi › API anahtarını gir'e yapıştır."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não reconheceu a chave de API. Se você a renovou no painel web, cole a chave nova em Acesso pela web › Digite a chave de API."
          }
        }
      }
    },
    "The server didn't recognise this key. Make sure you copied the latest key from the web panel.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bu anahtarı tanımadı. Web panelindeki en son anahtarı kopyaladığından emin ol."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não reconheceu esta chave. Confira se você copiou a chave mais recente do painel web."
          }
        }
      }
    },
    "The server is busy. Try again in a moment.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu meşgul. Biraz sonra tekrar dene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está ocupado. Tente de novo em instantes."
          }
        }
      }
    },
    "The server works by invitation. Ask the person who runs it for a code.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu davetle çalışıyor. Kodu sunucuyu işleten kişiden iste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor funciona por convite. Peça um código a quem o administra."
          }
        }
      }
    },
    "The sleep score is a weighted mean of what the band measured: duration 35, efficiency 15, deep sleep 10, REM 10, restfulness 10, regularity 10 and heart-rate dip 10.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku skoru, bandın ölçtüklerinin ağırlıklı ortalamasıdır: süre 35, verimlilik 15, derin uyku 10, REM 10, huzur 10, düzen 10 ve nabız düşüşü 10."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontuação do sono é uma média ponderada do que o relógio mediu: duração 35, eficiência 15, sono profundo 10, REM 10, tranquilidade 10, regularidade 10 e queda da frequência cardíaca 10."
          }
        }
      }
    },
    "There's no band in Freeband yet.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband'de henüz bant yok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nenhum relógio no Aravia."
          }
        }
      }
    },
    "This band doesn't offer the Bluetooth channel Freeband uses.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bant, Freeband'in kullandığı Bluetooth kanalını sunmuyor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relógio não oferece o canal Bluetooth que o Aravia usa."
          }
        }
      }
    },
    "This band's records, raw files, scores and key are deleted from this phone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bandın kayıtları, ham dosyaları, skorları ve anahtarı bu telefondan silinir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros, arquivos brutos, pontuações e a chave deste relógio são apagados deste celular."
          }
