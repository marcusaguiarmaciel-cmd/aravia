          }
        }
      }
    },
    "Freeband is an independent project, not affiliated with Xiaomi. Xiaomi, Mi Band and Mi Fitness are trademarks of Xiaomi Inc.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband bağımsız bir projedir ve Xiaomi ile bağlantılı değildir. Xiaomi, Mi Band ve Mi Fitness, Xiaomi Inc.'in markalarıdır."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
