    "Readings, the band's raw files, sleep and scores are deleted. Bands and their keys stay. Data on the server isn't affected.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ölçümler, bandın ham dosyaları, uyku ve skorlar silinir. Bantlar ve anahtarları kalır. Sunucudaki veri etkilenmez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As leituras, os arquivos brutos do relógio, o sono e as pontuações são apagados. Os relógios e as chaves ficam. Os dados no servidor não são afetados."
          }
        }
      }
    },
    "Reading…": {
      "localizations": {
        "tr": {
