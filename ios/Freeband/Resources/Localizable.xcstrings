{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ above usual": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalden %@ yüksek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ acima do normal"
          }
        }
      }
    },
    "%@ below usual": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalden %@ düşük"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abaixo do normal"
          }
        }
      }
    },
    "%@ can't vibrate on request.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istek üzerine titreyemez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não vibra sob comando."
          }
        }
      }
    },
    "%@ day: %lld min in heart-rate zones, most of it in zone %lld.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük: %1$@. Nabız bölgelerinde %2$lld dk, çoğu %3$lld. bölgede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dia %@: %lld min em zonas de frequência cardíaca, a maior parte na zona %lld."
          }
        }
      }
    },
    "%@ day: no time in heart-rate zones.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük: %@. Nabız bölgelerinde hiç vakit geçmedi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dia %@: nenhum tempo em zonas de frequência cardíaca."
          }
        }
      }
    },
    "%@ efficient": {
      "comment": "Sleep efficiency",
