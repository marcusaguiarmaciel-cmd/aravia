    "Each point is five minutes. The night's value is the middle one of the shaded second half, when the body is most settled.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her nokta beş dakikadır. Gecenin değeri, vücudun en sakin olduğu gölgeli ikinci yarının ortanca değeridir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ponto vale cinco minutos. O valor da noite é o do meio da segunda metade sombreada, quando o corpo está mais assentado."
          }
        }
      }
    },
