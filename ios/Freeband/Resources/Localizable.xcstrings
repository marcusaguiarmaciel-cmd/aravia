    "Recovery": {
      "comment": "Score name",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperação"
          }
        }
      }
    },
    "Recovery appears once the band knows your normal: it needs three nights of resting heart rate.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanma, bant normalini öğrenince görünür: üç gecelik dinlenik nabız gerekir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação aparece quando o relógio conhece o seu normal: ela precisa de três noites de frequência cardíaca em repouso."
          }
        }
      }
    },
    "Recovery compares each morning with your normal. Wear the band tonight; it needs three nights to learn it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanma her sabahı normalinle karşılaştırır. Bu gece bandı tak; normalini öğrenmesi için üç gece gerekiyor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação compara cada manhã com o seu normal. Durma com o relógio esta noite; ele precisa de três noites para aprender."
          }
        }
      }
    },
    "Recovery compares this morning with your own normal: the median of your previous 14 valid days.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanma bu sabahı kendi normalinle karşılaştırır: önceki 14 geçerli gününün ortancası."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação compara esta manhã com o seu próprio normal: a mediana dos seus 14 dias válidos anteriores."
          }
        }
      }
    },
