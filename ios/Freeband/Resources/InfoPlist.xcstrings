    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Privacy - Bluetooth Always Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Freeband uses Bluetooth to talk directly to the band on your wrist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband, bileğindeki bantla doğrudan konuşmak için Bluetooth kullanır."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Aravia usa o Bluetooth para conversar direto com o relógio no seu pulso."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "If you turn on Share location with the band, Freeband sends this phone's location to your band when the band asks for it. It goes nowhere else."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumu bantla paylaş'ı açarsan Freeband, bant istediğinde bu telefonun konumunu bandına gönderir. Başka hiçbir yere gitmez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você ligar Compartilhar localização com o relógio, o Aravia envia a localização deste celular ao seu relógio quando ele pedir. Ela não vai para nenhum outro lugar."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Aravia salva no seu rolo da câmera os vídeos de rota que você pedir."
          }
        }
      }
    }
  },
  "version": "1.0"
